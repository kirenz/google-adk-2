# Copy to the course root as .env; never commit secrets.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=replace-with-your-own-key
GEMINI_MODEL=gemini-flash-latest

# Required ONLY for --live. Use an independently provisioned SELECT-only login.
# SQLSERVER_URL=mssql+pyodbc://readonly_user:URL_ENCODED_PASSWORD@host/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# BI_READ_ONLY_ACCOUNT_CONFIRMED=yes
# Exact allowlisted view identifiers, comma-separated without spaces:
# BI_ALLOWED_VIEWS=dbo.CourseSales
# Supply the actual Global Bike schema you are permitted to query. This is a placeholder:
# BI_SCHEMA=dbo.CourseSales(Country nvarchar(100), NetSales decimal(18,2))
